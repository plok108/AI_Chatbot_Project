DATABASE_URL=postgresql://username:password@host:5432/database
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# JWT 인증 — 운영 환경에서는 강력한 랜덤 값으로 교체할 것
# 예) python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 추천 파이프라인 기능 스위치 (논문 ablation 실험용)
# 모두 false = 순수 GPT(baseline), 모두 true = 제안 시스템
ENABLE_SAFETY_FILTER=true
ENABLE_RERANK=true
ENABLE_CONTEXT=true

# 재정렬 점수 가중치 (합 1.0 권장)
WEIGHT_USAGE=0.4
WEIGHT_PREFERENCE=0.3
WEIGHT_CONTEXT=0.2
WEIGHT_COST=0.1

# 날씨 API (선택) — 키가 없으면 '시간대'만 상황 인식에 사용
# https://openweathermap.org/api 에서 무료 키 발급
WEATHER_API_KEY=
WEATHER_CITY=Seoul